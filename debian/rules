#!/usr/bin/make -f

%:
	dh $@

override_dh_fixperms:
	dh_fixperms
	chmod 0755 debian/lan-route-fixer/usr/bin/lan-route-fixer
	chmod 0755 debian/lan-route-fixer/usr/libexec/lan-route-fixer/lan-route-helper
	chmod 0755 debian/lan-route-fixer/usr/libexec/lan-route-fixer/lan-route-fixer-apply
	chmod 0755 debian/lan-route-fixer/etc/NetworkManager/dispatcher.d/90-lan-route-fixer
	find debian/lan-route-fixer/usr/lib/lan-route-fixer -type d -exec chmod 0755 {} +
	find debian/lan-route-fixer/usr/lib/lan-route-fixer -type f -exec chmod 0644 {} +
