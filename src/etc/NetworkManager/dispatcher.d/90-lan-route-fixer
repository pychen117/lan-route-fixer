#!/bin/sh
# Reapply lan-route-fixer host routes whenever a network interface or VPN
# link changes state. This script is invoked by NetworkManager as root.
INTERFACE="$1"
STATUS="$2"

case "$STATUS" in
    up|down|dhcp4-change|dhcp6-change|connectivity-change|vpn-up|vpn-down)
        /usr/libexec/lan-route-fixer/lan-route-fixer-apply
        ;;
esac

exit 0
