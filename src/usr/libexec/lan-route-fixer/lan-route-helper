#!/usr/bin/env python3
"""Privileged helper for lan-route-fixer.

It only accepts private/local destinations and a non-tunnel LAN interface, and
only performs ``ip route replace`` plus the matching policy-rule bookkeeping.
The file must remain root-owned and unmodifiable by regular users.

Usage:
    lan-route-helper <address> <interface>
    lan-route-helper --batch-json '<json-array>'
        accepts the route items as a command-line JSON argument so callers do
        not depend on pkexec forwarding stdin.
    lan-route-helper --batch
        legacy mode, reads a JSON array from stdin.
"""

import os
import sys
from pathlib import Path

LIB_DIR = Path(os.environ.get("LAN_ROUTE_FIXER_LIB", "/usr/lib/lan-route-fixer"))
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from lanrf.helper import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
