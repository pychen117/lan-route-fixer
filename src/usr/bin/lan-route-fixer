#!/usr/bin/env python3
"""lan-route-fixer entry point: dispatch to the CLI, the daemon or the GUI.

A leading option (``--config PATH``) does not force the GUI: the first
non-option token decides, so ``lan-route-fixer --config x.json check`` behaves
the way users expect. The decision itself lives in :mod:`lanrf.dispatch` so it
can be unit tested without importing GTK.
"""

import os
import sys
from pathlib import Path

LIB_DIR = Path(os.environ.get("LAN_ROUTE_FIXER_LIB", "/usr/lib/lan-route-fixer"))
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    from lanrf import dispatch

    if argv and argv[0] == "--version":
        from lanrf import __version__

        print(f"lan-route-fixer {__version__}")
        return 0

    if dispatch.wants_cli(argv):
        import core

        return core.cli_main(argv)

    import app

    return app.main()


if __name__ == "__main__":
    raise SystemExit(main())
